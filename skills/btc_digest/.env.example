# FRED API (optional; add for macro data)
FRED_API_KEY=

# CoinGecko Pro (optional; free tier works)
COINGECKO_API_KEY=

# exchangerate.host (optional; falls back to CoinGecko SGD)
EXCHANGERATE_API_KEY=

# OpenClaw delivery
OPENCLAW_CHANNEL=telegram
OPENCLAW_TO=737798118

# Locale
TIMEZONE=Asia/Singapore
DIGEST_LANG=en

# Paths
OUTPUT_DIR=./out
# Chart save dir (default /tmp so OpenClaw can attach it). Override if media fails.
CHART_DIR=/tmp
CACHE_TTL_SEC=300

# RSS feeds (comma-separated; leave empty to disable news)
# RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
